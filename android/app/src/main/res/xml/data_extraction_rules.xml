<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules: study progress, streak and quiz results are
     device-local by design (no account), and downloaded PDFs are re-downloadable,
     so nothing is backed up or transferred. Keeping this explicit avoids a Play
     "data safety" mismatch. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
